  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  if [[ $# -gt 0 ]]; then
    echo "Unknown argument: $1" >&2
    exit 1
  fi
  resolve_interactive_ssh_target_required
  vm_ssh_tty 'sudo -u ctf -i'
}

cmd_logs() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  if [[ $# -gt 0 ]]; then
    echo "Unknown argument: $1" >&2
    exit 1
  fi
  resolve_target_required
  gcloud_ssh "sudo -u ctf bash -lc 'tail -n 200 -f ${REMOTE_RUN_DIR}/logs/supervisor.log'"
}

cmd_monitor() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  if [[ $# -gt 0 ]]; then
    echo "Unknown argument: $1" >&2
    exit 1
  fi
  resolve_target_required
  gcloud_ssh "sudo -u ctf bash -lc '
    if ! tmux has-session -t ctf 2>/dev/null; then
      echo \"No tmux session named ctf found.\"
      exit 1
    fi
    while true; do
      if [ -n \"${TERM:-}\" ] && [ \"${TERM}\" != \"dumb\" ]; then
        clear || true
      fi
      echo \"=== ctfvm monitor: ${INSTANCE} (${ZONE}) ===\"
      date -u +\"UTC %Y-%m-%d %H:%M:%S\"
      echo
      echo \"--- tmux windows ---\"
      tmux list-windows -t ctf || true
      echo
      echo \"--- supervisor pane (last 120 lines) ---\"
      tmux capture-pane -p -t ctf:supervisor -S -120 2>/dev/null || echo \"supervisor window not found\"
      sleep 2
    done
  '"
}

cmd_ui() {
  local host="127.0.0.1"
  local port="8765"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host)
        host="$2"; shift 2 ;;
      --port)
        port="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  require_cmd python3
  python3 "${REPO_ROOT}/scripts/ctfvm_ui.py" --host "${host}" --port "${port}"
}

cmd_mcp() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local restart_supervisor="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --restart-supervisor)
        restart_supervisor="1"; shift ;;
      *)
        break ;;
    esac
  done

  if [[ $# -lt 1 ]]; then
    echo "Usage: ctfvm mcp [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--zone <zone> --project <project>]] [--restart-supervisor] <list|get|add|remove|login|logout> [args...]" >&2
    exit 1
  fi

  local subcmd="$1"
  case "${subcmd}" in
    list|get|add|remove|login|logout) ;;
    *)
      echo "Unknown mcp subcommand: ${subcmd}" >&2
      echo "Supported subcommands: list, get, add, remove, login, logout" >&2
      exit 1 ;;
  esac

  resolve_target_required
  run_remote_codex_mcp "$@"

  if [[ "${restart_supervisor}" == "1" ]]; then
    case "${subcmd}" in
      add|remove|login|logout)
        echo "Restarting supervisor window so Codex picks up the updated MCP configuration."
        launch_supervisor_tmux "${REMOTE_RUN_DIR}" "${REMOTE_RUN_DIR}/challenge_prompt.txt"
        ;;
    esac
  else
    case "${subcmd}" in
      add|remove|login|logout)
        echo "MCP config updated on the VM."
        echo "If Codex is already running in tmux, rerun with --restart-supervisor to reload it."
        ;;
    esac
  fi
}

cmd_bridge_up() {
  local bridge_name="default"
  local config_file=""
  local state_file=""
  local state_dir=""
  local ssh_log=""
  local ssh_pid=""
  local docker_gateway_ip=""
  local targets_file=""
  local state_targets_file=""
  local stage_dir=""
  local remote_json=""
  local remote_env=""
  local local_json=""
  local target_name=""
  local internal_host=""
  local internal_port=""
  local vm_port=""
  local remote_pid=""
  local summary_line=""
  local -a forwards=()
  local -a started_remote_pids=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        bridge_name="$2"; shift 2 ;;
      --config)
        config_file="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  if [[ ! "${bridge_name}" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    echo "Invalid bridge name: ${bridge_name}" >&2
    exit 1
  fi
  if [[ -z "${config_file}" ]]; then
    echo "Missing required flag: --config <local-json>" >&2
    exit 1
  fi

  resolve_target_required
  ensure_state_dir
  state_dir="$(bridge_state_dir)"
  state_file="$(bridge_state_file "${bridge_name}")"
  ssh_log="$(bridge_local_log_file "${bridge_name}")"
  if [[ -f "${state_file}" ]]; then
    echo "Bridge ${bridge_name} already exists for $(bridge_target_key)." >&2
    exit 1
  fi
  mkdir -p "${state_dir}"

  targets_file="$(mktemp)"
  state_targets_file="$(mktemp)"
  if ! bridge_write_normalized_targets "${config_file}" "${targets_file}"; then
    rm -f "${targets_file}" "${state_targets_file}"
    exit 1
  fi

  if ! bridge_container_host_ready >/dev/null 2>&1; then
    rm -f "${targets_file}" "${state_targets_file}"
    echo "ctf-toolbox is not exposing host.docker.internal on this VM. Recreate the VM with the updated ctfvm tooling and try again." >&2
    exit 1
  fi
  if ! gcloud_ssh "command -v socat >/dev/null 2>&1"; then
    rm -f "${targets_file}" "${state_targets_file}"
    echo "Remote VM is missing socat. Recreate the VM with the updated startup script and try again." >&2
    exit 1
  fi
  gcloud_ssh "sudo -u ctf bash -lc 'mkdir -p ${REMOTE_BRIDGE_DIR}'"
  docker_gateway_ip="$(bridge_container_gateway_ip | tr -d '[:space:]')"
  if [[ -z "${docker_gateway_ip}" ]]; then
    rm -f "${targets_file}" "${state_targets_file}"
    echo "Could not determine the VM host gateway IP from ctf-toolbox." >&2
    exit 1
  fi

  while IFS=$'\t' read -r target_name internal_host internal_port vm_port || [[ -n "${target_name}${internal_host}${internal_port}${vm_port}" ]]; do
    forwards+=("127.0.0.1:${vm_port}:${internal_host}:${internal_port}")
  done < "${targets_file}"

  if ! ssh_pid="$(bridge_start_local_tunnel "${ssh_log}" "${forwards[@]}")"; then
    rm -f "${targets_file}" "${state_targets_file}"
    rm -f "${ssh_log}"
    rmdir "${state_dir}" >/dev/null 2>&1 || true
    exit 1
  fi

  while IFS=$'\t' read -r target_name internal_host internal_port vm_port || [[ -n "${target_name}${internal_host}${internal_port}${vm_port}" ]]; do
    if ! remote_pid="$(bridge_start_remote_socat "${docker_gateway_ip}" "${vm_port}" "${bridge_name}" "${target_name}")"; then
      for remote_pid in "${started_remote_pids[@]}"; do
        bridge_kill_remote_pid "${remote_pid}"
      done
      kill "${ssh_pid}" >/dev/null 2>&1 || true
      rm -f "${targets_file}" "${state_targets_file}" "${ssh_log}"
      rmdir "${state_dir}" >/dev/null 2>&1 || true
      exit 1
    fi
    started_remote_pids+=("${remote_pid}")
    printf '%s\t%s\t%s\t%s\t%s\n' "${target_name}" "${internal_host}" "${internal_port}" "${vm_port}" "${remote_pid}" >> "${state_targets_file}"
  done < "${targets_file}"

  local_json="$(bridge_state_file "${bridge_name}")"
  bridge_write_local_state_json "${bridge_name}" "${state_targets_file}" "${ssh_pid}" "${ssh_log}" "${local_json}"
  stage_dir="$(mktemp -d)"
  remote_json="${stage_dir}/${bridge_name}.json"
  remote_env="${stage_dir}/${bridge_name}.env"
  bridge_write_remote_state_json "${bridge_name}" "${state_targets_file}" "${remote_json}"
  bridge_write_env_file "${state_targets_file}" "${remote_env}"
  if ! upload_dir_to_remote "${stage_dir}" "${REMOTE_BRIDGE_DIR}"; then
    for remote_pid in "${started_remote_pids[@]}"; do
      bridge_kill_remote_pid "${remote_pid}"
    done
    kill "${ssh_pid}" >/dev/null 2>&1 || true
    rm -rf "${stage_dir}"
    rm -f "${targets_file}" "${state_targets_file}"
    bridge_remove_local_state_file "${local_json}"
    exit 1
  fi

  rm -rf "${stage_dir}"
  rm -f "${targets_file}" "${state_targets_file}"

  echo "Bridge ${bridge_name} is up for ${INSTANCE}."
  while IFS=$'\t' read -r target_name internal_host internal_port vm_port remote_pid || [[ -n "${target_name}${vm_port}" ]]; do
    summary_line="${target_name}: ${internal_host}:${internal_port} -> host.docker.internal:${vm_port}"
    echo "  ${summary_line}"
  done < <(jq -r '.targets[] | [.name, .internal_host, (.internal_port | tostring), (.vm_port | tostring), (.remote_socat_pid | tostring)] | @tsv' "${local_json}")
  echo "  Remote env: $(bridge_remote_env_file "${bridge_name}")"
}

cmd_bridge_status() {
  local bridge_name="default"
  local state_file=""
  local ssh_pid=""
  local ssh_status="down"
  local remote_reachable="0"
  local container_status="unavailable"
  local target_name=""
  local container_host=""
  local vm_port=""
  local internal_host=""
  local internal_port=""
  local remote_pid=""
  local remote_status="unknown"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        bridge_name="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required
  require_cmd jq
  state_file="$(bridge_state_file "${bridge_name}")"
  if [[ ! -f "${state_file}" ]]; then
    echo "Bridge state not found: ${state_file}" >&2
    exit 1
  fi

  ssh_pid="$(jq -r '.ssh_pid' "${state_file}")"
  if bridge_local_pid_alive "${ssh_pid}"; then
    ssh_status="up"
  fi
  if bridge_container_host_ready >/dev/null 2>&1; then
    remote_reachable="1"
    container_status="ready"
  fi

  echo "Bridge ${bridge_name}"
  echo "  Instance: ${INSTANCE} ($(provider_label "${PROVIDER}"))"
  echo "  SSH tunnel: pid=${ssh_pid} status=${ssh_status}"
  echo "  Container host mapping: ${container_status}"

  while IFS=$'\t' read -r target_name container_host vm_port internal_host internal_port remote_pid || [[ -n "${target_name}${vm_port}${remote_pid}" ]]; do
    remote_status="unknown"
    if [[ "${remote_reachable}" == "1" ]]; then
      if bridge_remote_pid_alive "${remote_pid}"; then
        remote_status="up"
      else
        remote_status="down"
      fi
    fi
    echo "  ${target_name}: ${container_host}:${vm_port} -> ${internal_host}:${internal_port} (socat pid=${remote_pid}, status=${remote_status})"
  done < <(jq -r '.targets[] | [.name, .container_host, (.vm_port | tostring), .internal_host, (.internal_port | tostring), (.remote_socat_pid | tostring)] | @tsv' "${state_file}")
}

cmd_bridge_down() {
  local bridge_name="default"
  local state_file=""
  local ssh_pid=""
  local target_name=""
  local remote_pid=""
  local remote_cleanup_cmd=""
  local state_dir=""
  local remote_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        bridge_name="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required
  require_cmd jq
  state_file="$(bridge_state_file "${bridge_name}")"
  if [[ ! -f "${state_file}" ]]; then
    echo "Bridge state not found: ${state_file}" >&2
    exit 1
  fi

  while IFS=$'\t' read -r target_name remote_pid || [[ -n "${target_name}${remote_pid}" ]]; do
    bridge_kill_remote_pid "${remote_pid}"
  done < <(jq -r '.targets[] | [.name, (.remote_socat_pid | tostring)] | @tsv' "${state_file}")

  ssh_pid="$(jq -r '.ssh_pid' "${state_file}")"
  kill "${ssh_pid}" >/dev/null 2>&1 || true

  printf -v remote_cleanup_cmd 'rm -f %q %q' "$(bridge_remote_json_file "${bridge_name}")" "$(bridge_remote_env_file "${bridge_name}")"
  while IFS=$'\t' read -r target_name remote_pid || [[ -n "${target_name}" ]]; do
    remote_path="$(bridge_remote_socat_log_file "${bridge_name}" "${target_name}")"
    printf -v remote_cleanup_cmd '%s %q' "${remote_cleanup_cmd}" "${remote_path}"
  done < <(jq -r '.targets[] | [.name, (.remote_socat_pid | tostring)] | @tsv' "${state_file}")
  gcloud_ssh "sudo -u ctf bash -lc '${remote_cleanup_cmd}'" >/dev/null 2>&1 || true

  bridge_remove_local_state_file "${state_file}"
  state_dir="$(bridge_state_dir)"
  rmdir "${state_dir}" >/dev/null 2>&1 || true
  echo "Bridge ${bridge_name} removed."
}

cmd_bridge_list() {
  local state_dir=""
  local state_file=""

  if [[ $# -gt 0 ]]; then
    echo "Usage: ctfvm bridge [selector] list" >&2
    exit 1
  fi

  resolve_target_required
  require_cmd jq
  state_dir="$(bridge_state_dir)"
  if [[ ! -d "${state_dir}" ]]; then
    echo "No bridge state found for $(bridge_target_key)."
    exit 0
  fi

  for state_file in "${state_dir}"/*.json; do
    [[ -e "${state_file}" ]] || continue
    jq -r '"\(.name): \(.targets | length) target(s), updated \(.updated_at)"' "${state_file}"
    jq -r '.targets[] | "  \(.name): \(.container_host):\(.vm_port) -> \(.internal_host):\(.internal_port)"' "${state_file}"
  done
}

cmd_bridge() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}

  if [[ $# -lt 1 ]]; then
    echo "Usage: ctfvm bridge [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] <up|status|down|list> [args...]" >&2
    exit 1
  fi

  local subcmd="$1"
  shift

  case "${subcmd}" in
    up)
      cmd_bridge_up "$@" ;;
    status)
      cmd_bridge_status "$@" ;;
    down)
      cmd_bridge_down "$@" ;;
    list)
      cmd_bridge_list "$@" ;;
    *)
      echo "Unknown bridge subcommand: ${subcmd}" >&2
      echo "Supported subcommands: up, status, down, list" >&2
      exit 1 ;;
  esac
}

cmd_inject() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local msg=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --msg)
        msg="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ -z "${msg}" ]]; then
    echo "Missing required flag: --msg \"...\"" >&2
    exit 1
  fi

  local line payload_b64
  line="[$(date -u +%Y-%m-%dT%H:%M:%SZ)] ${msg}"
  payload_b64="$(printf '%s' "${line}" | base64)"
  gcloud_ssh "sudo -u ctf bash -lc 'printf \"%s\" \"${payload_b64}\" | base64 -d >> ${REMOTE_RUN_DIR}/inject.queue && printf \"\\n\" >> ${REMOTE_RUN_DIR}/inject.queue'"
  echo "Injected message into ${REMOTE_RUN_DIR}/inject.queue"
}

cmd_send() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local text=""
  local target="ctf:supervisor"
  local enter="1"
  local session_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --text)
        text="$2"; shift 2 ;;
      --target)
        target="$2"; shift 2 ;;
      --no-enter)
        enter="0"; shift ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ -z "${text}" ]]; then
    echo "Missing required flag: --text \"...\"" >&2
    exit 1
  fi
  if [[ ! "${target}" =~ ^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$ ]]; then
    echo "Invalid target: ${target}" >&2
    echo "Allowed target format: <tmux-session>:<window-or-pane> (for example: ctf:supervisor, ctf:0, subagent-<id>:0)" >&2
    exit 1
  fi
  session_name="${target%%:*}"

  local payload_b64
  payload_b64="$(printf '%s' "${text}" | base64 | tr -d '\n')"
  if [[ "${enter}" == "1" ]]; then
    # Send payload and submit key in one remote tmux call to avoid race between separate SSH calls.
    gcloud_ssh "sudo -u ctf bash -lc 'tmux has-session -t \"${session_name}\" >/dev/null 2>&1 || { echo \"No tmux session ${session_name}\" >&2; exit 1; }; payload=\"\$(printf \"%s\" \"${payload_b64}\" | base64 -d)\"; tmux send-keys -t \"${target}\" -l -- \"\${payload}\"; sleep 0.08; tmux send-keys -t \"${target}\" C-m'"
  else
    gcloud_ssh "sudo -u ctf bash -lc 'tmux has-session -t \"${session_name}\" >/dev/null 2>&1 || { echo \"No tmux session ${session_name}\" >&2; exit 1; }; payload=\"\$(printf \"%s\" \"${payload_b64}\" | base64 -d)\"; tmux send-keys -t \"${target}\" -l -- \"\${payload}\"'"
  fi
  echo "Sent input to ${target}"
}

cmd_ideas() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local ideas=""
  local ideas_file=""
  local parallel=""
  local model=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ideas)
        ideas="$2"; shift 2 ;;
      --ideas-file)
        ideas_file="$2"; shift 2 ;;
      --parallel)
        parallel="$2"; shift 2 ;;
      --model)
        model="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ -n "${ideas}" && -n "${ideas_file}" ]]; then
    echo "Use either --ideas or --ideas-file, not both." >&2
    exit 1
  fi
  if [[ -z "${ideas}" && -z "${ideas_file}" ]]; then
    echo "Missing required input. Use --ideas or --ideas-file." >&2
    exit 1
  fi
  if [[ -n "${parallel}" && ( ! "${parallel}" =~ ^[0-9]+$ || "${parallel}" -lt 1 ) ]]; then
    echo "Invalid --parallel value: ${parallel} (must be >= 1)." >&2
    exit 1
  fi
  if [[ -n "${model}" && ! "${model}" =~ ^[A-Za-z0-9._:-]+$ ]]; then
    echo "Invalid --model value: ${model}" >&2
    echo "Allowed characters: letters, numbers, dot, underscore, colon, hyphen." >&2
    exit 1
  fi

  local ideas_content=""
  if [[ -n "${ideas_file}" ]]; then
    if [[ ! -f "${ideas_file}" ]]; then
      echo "Ideas file not found: ${ideas_file}" >&2
      exit 1
    fi
    ideas_content="$(cat "${ideas_file}")"
  else
    ideas_content="${ideas}"
  fi

  if [[ -z "${ideas_content//[[:space:]]/}" ]]; then
    echo "No non-empty ideas provided." >&2
    exit 1
  fi

  local remote_ideas_file payload_b64 run_cmd rc
  remote_ideas_file="${REMOTE_RUN_DIR}/ideas-input-$(date +%Y%m%d-%H%M%S)-$RANDOM.txt"
  payload_b64="$(printf '%s' "${ideas_content}" | base64 | tr -d '\n')"

  gcloud_ssh "sudo -u ctf bash -lc 'printf \"%s\" \"${payload_b64}\" | base64 -d > ${remote_ideas_file} && chmod 600 ${remote_ideas_file}'"

  run_cmd="/home/ctf/run/spawn-idea-workers.sh --run-dir /home/ctf/run --ideas-file ${remote_ideas_file}"
  if [[ -n "${parallel}" ]]; then
    run_cmd="${run_cmd} --parallel ${parallel}"
  fi
  if [[ -n "${model}" ]]; then
    run_cmd="${run_cmd} --model ${model}"
  fi

  set +e
  gcloud_ssh "sudo -u ctf bash -lc '${run_cmd}'"
  rc=$?
  gcloud_ssh "sudo -u ctf bash -lc 'rm -f ${remote_ideas_file}'" >/dev/null 2>&1 || true
  set -e

  if [[ "${rc}" -ne 0 ]]; then
    echo "Failed to spawn idea worker tmux windows. Check ${REMOTE_RUN_DIR}/logs/supervisor.log and tmux session state." >&2
    exit "${rc}"
  fi

  echo "Idea worker windows spawned in tmux session ctf."
  echo "  Attach:    ${SCRIPT_DIR}/ctfvm attach --run-id ${RUN_ID}"
  echo "  Steer:     ${SCRIPT_DIR}/ctfvm send --run-id ${RUN_ID} --target ctf:idea-001 --text \"...\""
  echo "  Logs:      ${REMOTE_RUN_DIR}/logs/worker-idea-*.log"
  echo "  Artifacts: ${REMOTE_RUN_DIR}/artifacts/ideas/"
}

cmd_sync_skill() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local skill_name="ctf-exploit-subagent"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skill)
        skill_name="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ ! "${skill_name}" =~ ^[a-z0-9-]+$ ]]; then
    echo "Invalid skill name: ${skill_name}" >&2
    echo "Use lowercase letters, digits, and hyphens only." >&2
    exit 1
  fi

  local local_skill_dir remote_tmp local_stage
  local_skill_dir="${REPO_ROOT}/skills/${skill_name}"
  if [[ ! -f "${local_skill_dir}/SKILL.md" ]]; then
    echo "Skill not found or invalid: ${local_skill_dir}" >&2
    exit 1
  fi

  remote_tmp="/tmp/ctfvm-skill-sync-${skill_name}-$$"
  local_stage="$(mktemp -d)"
  cp -R "${local_skill_dir}" "${local_stage}/"
  gcloud_ssh "mkdir -p ${remote_tmp}"
  upload_dir_to_remote "${local_stage}" "${remote_tmp}"
  gcloud_ssh "sudo mkdir -p /home/ctf/run/.codex/skills && sudo rm -rf /home/ctf/run/.codex/skills/${skill_name} && sudo cp -R ${remote_tmp}/${skill_name} /home/ctf/run/.codex/skills/${skill_name} && sudo chown -R ctf:ctf /home/ctf/run/.codex/skills/${skill_name} && rm -rf ${remote_tmp}"
  rm -rf "${local_stage}"

  echo "Synced skill ${skill_name} to /home/ctf/run/.codex/skills/${skill_name}"
}

cmd_key() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local target="ctf:supervisor"
  local session_name=""
  local keys=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        target="$2"; shift 2 ;;
      --key)
        keys+=("$2"); shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ ${#keys[@]} -eq 0 ]]; then
    echo "Missing required flag: --key <tmux-key>" >&2
    echo "Example: ctfvm key --key C-c --key Enter" >&2
    exit 1
  fi
  if [[ ! "${target}" =~ ^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$ ]]; then
    echo "Invalid target: ${target}" >&2
    exit 1
  fi
  session_name="${target%%:*}"

  local cmd="tmux has-session -t \"${session_name}\" >/dev/null 2>&1 || { echo \"No tmux session ${session_name}\" >&2; exit 1; }; tmux send-keys -t \"${target}\""
  local k
  for k in "${keys[@]}"; do
    if [[ ! "${k}" =~ ^[A-Za-z0-9^:_+-]+$ ]]; then
      echo "Invalid key token: ${k}" >&2
      exit 1
    fi
    cmd="${cmd} ${k}"
  done

  gcloud_ssh "sudo -u ctf bash -lc '${cmd}'"
  echo "Sent keys to ${target}: ${keys[*]}"
}

cmd_sync_down() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local out_dir=""
  local remote_path="/home/ctf/run/challenge"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out)
        out_dir="$2"; shift 2 ;;
      --remote-path)
        remote_path="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ -z "${out_dir}" ]]; then
    out_dir="./ctfvm-live-${RUN_ID}"
  fi

  mkdir -p "${out_dir}"
  gcloud_ssh "sudo -u ctf bash -lc 'test -d \"${remote_path}\"'"
  local remote_tar="/tmp/ctfvm-sync-down-${RUN_ID:-manual}-$$.tar"
  gcloud_ssh "sudo -u ctf bash -lc 'tmp=${remote_tar}; rm -f \"${tmp}\"; tar -C \"${remote_path}\" -cf \"${tmp}\" .'"
  download_file_from_remote "${remote_tar}" "${out_dir}/.ctfvm-sync.tar"
  tar -C "${out_dir}" -xf "${out_dir}/.ctfvm-sync.tar"
  rm -f "${out_dir}/.ctfvm-sync.tar"
  gcloud_ssh "rm -f \"${remote_tar}\"" >/dev/null 2>&1 || true
  echo "Synced remote ${remote_path} -> $(cd "${out_dir}" && pwd)"
}

cmd_sync_up() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local src_dir=""
  local remote_path="/home/ctf/run/challenge"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --src)
        src_dir="$2"; shift 2 ;;
      --remote-path)
        remote_path="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ -z "${src_dir}" ]]; then
    echo "Missing required flag: --src <local-dir>" >&2
    exit 1
  fi
  if [[ ! -d "${src_dir}" ]]; then
    echo "Source directory not found: ${src_dir}" >&2
    exit 1
  fi

  upload_dir_to_remote "${src_dir}" "${remote_path}"
  echo "Synced $(cd "${src_dir}" && pwd) -> remote ${remote_path}"
}

cmd_vscode() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  resolve_target_required
  require_cmd code

  local remote_path="${REMOTE_RUN_DIR}/challenge"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remote-path)
        remote_path="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  local host_alias
  if [[ -z "${IP:-}" ]]; then
    refresh_instance_ip
  fi
  ctfvm_provider_call "${PROVIDER}" prepare_vscode_host "${INSTANCE}" "${ZONE}" "${PROJECT}" "${IP:-}" || true
  host_alias="$(ctfvm_provider_call "${PROVIDER}" vscode_host_alias "${INSTANCE}" "${ZONE}" "${PROJECT}" "${IP:-}")"
  code --folder-uri "vscode-remote://ssh-remote+${host_alias}${remote_path}"
  echo "Opened VS Code Remote-SSH at ${host_alias}:${remote_path}"
}

cmd_fetch() {
  parse_selector_args "$@"
  set -- ${PARSED_SELECTOR_ARGS[@]+"${PARSED_SELECTOR_ARGS[@]}"}
  local out_dir=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out)
        out_dir="$2"; shift 2 ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  resolve_target_required

  if [[ -z "${out_dir}" ]]; then
    out_dir="./ctfvm-output-${RUN_ID}"
  fi

  mkdir -p "${out_dir}"

  local remote_tar="/tmp/ctfvm-${RUN_ID}.tar.gz"
  gcloud_ssh "sudo -u ctf bash -lc 'cd ${REMOTE_RUN_DIR} && tar -czf ${remote_tar} findings.md artifacts logs inject.queue challenge_prompt.txt 2>/dev/null || tar -czf ${remote_tar} artifacts logs challenge_prompt.txt'"
  download_file_from_remote "${remote_tar}" "${out_dir}/ctfvm-${RUN_ID}.tar.gz"
  gcloud_ssh "rm -f ${remote_tar}" >/dev/null 2>&1 || true

  tar -xzf "${out_dir}/ctfvm-${RUN_ID}.tar.gz" -C "${out_dir}"
  echo "Fetched artifacts into: $(cd "${out_dir}" && pwd)"
}

cmd_destroy() {
  local no_wipe="0"
  local destroy_all="0"
  local pick="0"
  local run_id_selector=""
  local clear_state="0"
  local local_selector_used="0"
  local instance_override=""
  local zone_override=""
  local project_override=""
  local provider_override=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        destroy_all="1"; shift ;;
      --pick)
        pick="1"; shift ;;
      --run-id)
        run_id_selector="$2"; shift 2 ;;
      --instance)
        instance_override="$2"; shift 2 ;;
      --zone)
        zone_override="$2"; shift 2 ;;
      --project)
        project_override="$2"; shift 2 ;;
      --provider)
        provider_override="$(normalize_provider "$2")"; shift 2 ;;
      --no-wipe-auth)
        no_wipe="1"; shift ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  cleanup_local_state_for_instance() {
    local inst="$1"
    local zn="$2"
    local proj="$3"
    local f fi_inst fi_zone fi_proj
    local run_guess=""
    if [[ "${inst}" == ctfvm-* ]]; then
      run_guess="$(run_id_from_instance_name "${inst}")"
      rm -f "${RUNS_DIR}/${run_guess}.json"
    fi
    for f in "${RUNS_DIR}"/*.json; do
      [[ -e "${f}" ]] || continue
      fi_inst="$(json_get_from_file instance "${f}" || true)"
      fi_zone="$(json_get_from_file zone "${f}" || true)"
      fi_proj="$(json_get_from_file project "${f}" || true)"
      if [[ "${fi_inst}" == "${inst}" && ( -z "${fi_zone}" || -z "${zn}" || "${fi_zone}" == "${zn}" ) && ( -z "${fi_proj}" || -z "${proj}" || "${fi_proj}" == "${proj}" ) ]]; then
        rm -f "${f}"
      fi
    done
    if [[ -f "${STATE_FILE}" ]]; then
      fi_inst="$(json_get instance || true)"
      fi_zone="$(json_get zone || true)"
      fi_proj="$(json_get project || true)"
      if [[ "${fi_inst}" == "${inst}" && ( -z "${fi_zone}" || -z "${zn}" || "${fi_zone}" == "${zn}" ) && ( -z "${fi_proj}" || -z "${proj}" || "${fi_proj}" == "${proj}" ) ]]; then
        rm -f "${STATE_FILE}"
      fi
    fi
  }

  destroy_one_instance() {
    local provider="$1"
    local inst="$2"
    local zn="$3"
    local proj="$4"
    local inst_ip="${5:-}"
    local prev_provider="${PROVIDER:-}"
    local prev_instance="${INSTANCE:-}"
    local prev_zone="${ZONE:-}"
    local prev_project="${PROJECT:-}"
    local prev_ip="${IP:-}"
    PROVIDER="${provider}"
    INSTANCE="${inst}"
    ZONE="${zn}"
    PROJECT="${proj}"
    IP="${inst_ip}"
    if [[ "${no_wipe}" == "0" ]]; then
      echo "Wiping VM Codex session material before deletion: ${inst} (${zn}, $(provider_label "${provider}"))"
      gcloud_ssh "sudo -u ctf bash -lc '
        if [ -d /home/ctf/run/.codex ]; then
          find /home/ctf/run/.codex -type f -exec shred -u {} + 2>/dev/null || rm -rf /home/ctf/run/.codex
        fi
        if [ -d /home/ctf/.codex ]; then
          find /home/ctf/.codex -type f -exec shred -u {} + 2>/dev/null || rm -rf /home/ctf/.codex
        fi
        if [ -d /home/ctf/.docker ]; then
          find /home/ctf/.docker -type f -exec shred -u {} + 2>/dev/null || rm -rf /home/ctf/.docker
        fi
      '" </dev/null || true
    fi
    echo "Deleting instance ${inst}..."
    if ! ctfvm_provider_call "${provider}" delete_instance "${inst}" "${zn}" "${proj}" </dev/null; then
      echo "Instance deletion returned non-zero for ${inst} (possibly already deleted)." >&2
    fi
    cleanup_local_state_for_instance "${inst}" "${zn}" "${proj}"
    PROVIDER="${prev_provider}"
    INSTANCE="${prev_instance}"
    ZONE="${prev_zone}"
    PROJECT="${prev_project}"
    IP="${prev_ip}"
  }

  if [[ "${destroy_all}" == "1" && ( "${pick}" == "1" || -n "${run_id_selector}" || -n "${instance_override}" || -n "${zone_override}" || -n "${project_override}" || -n "${provider_override}" ) ]]; then
    echo "Use --all by itself (optionally with --no-wipe-auth)." >&2
    exit 1
  fi
  if [[ "${pick}" == "1" && ( -n "${run_id_selector}" || -n "${instance_override}" || -n "${zone_override}" || -n "${project_override}" || -n "${provider_override}" ) ]]; then
    echo "Use --pick by itself, or use explicit selectors (--run-id/--instance/--provider/--zone/--project)." >&2
    exit 1
  fi
  if [[ -n "${run_id_selector}" && -n "${instance_override}" ]]; then
    echo "Use either --run-id or --instance, not both." >&2
    exit 1
  fi
  if [[ -n "${run_id_selector}" && ( -n "${zone_override}" || -n "${project_override}" || -n "${provider_override}" ) ]]; then
    echo "--run-id cannot be combined with --provider/--zone/--project." >&2
    exit 1
  fi

  if [[ "${destroy_all}" == "1" ]]; then
    local rows_all line_all provider_all inst_all zone_all proj_all ip_all count_all rows_all_tmp
    rows_all="$(ctfvm_provider_list_running_all)"
    if [[ -z "${rows_all//[[:space:]]/}" ]]; then
      echo "No running ctfvm instances found across configured providers."
      exit 0
    fi
    rows_all_tmp="$(mktemp)"
    printf '%s\n' "${rows_all}" > "${rows_all_tmp}"
    count_all=0
    while IFS= read -r -u 9 line_all; do
      [[ -z "${line_all//[[:space:]]/}" ]] && continue
      provider_all="$(awk -F'\t' '{print $1}' <<< "${line_all}")"
      inst_all="$(awk -F'\t' '{print $2}' <<< "${line_all}")"
      zone_all="$(awk -F'\t' '{print $3}' <<< "${line_all}")"
      proj_all="$(awk -F'\t' '{print $4}' <<< "${line_all}")"
      ip_all="$(awk -F'\t' '{print $6}' <<< "${line_all}")"
      [[ -n "${provider_all}${inst_all}${zone_all}" ]] || continue
      destroy_one_instance "${provider_all}" "${inst_all}" "${zone_all}" "${proj_all}" "${ip_all}"
      count_all=$((count_all + 1))
    done 9< "${rows_all_tmp}"
    rm -f "${rows_all_tmp}"
    echo "Destroyed ${count_all} ctfvm instance(s)."
    echo "Matching local state entries cleared."
    return 0
  fi

  if [[ "${pick}" == "1" || ( -z "${run_id_selector}" && -z "${instance_override}" ) ]]; then
    if ! choose_running_instance_interactive; then
      echo "Could not pick a running instance." >&2
      exit 1
    fi
  elif [[ -n "${run_id_selector}" ]]; then
    load_state_required_for_selector "${run_id_selector}" ""
    local_selector_used="1"
  elif [[ -n "${instance_override}" && -z "${zone_override}" && -z "${project_override}" ]]; then
    load_state_required_for_selector "" "${instance_override}"
    local_selector_used="1"
  elif [[ -n "${instance_override}" ]]; then
    PROVIDER="$(normalize_provider "${provider_override:-$(default_provider)}")"
    INSTANCE="${instance_override}"
    ZONE="${zone_override}"
    PROJECT="${project_override}"
    if [[ -z "${ZONE}" ]]; then
      ZONE="$(ctfvm_provider_call "${PROVIDER}" default_location)"
      if [[ "${PROVIDER}" == "digitalocean" && -z "${ZONE}" ]] && command -v doctl >/dev/null 2>&1; then
        ZONE="$(ctfvm_provider_call "${PROVIDER}" get_region "${INSTANCE}")"
      fi
    fi
    if [[ -z "${PROJECT}" ]]; then
      PROJECT="$(ctfvm_provider_call "${PROVIDER}" default_scope)"
    fi
    if [[ -z "${ZONE}" || -z "${PROJECT}" ]]; then
      echo "When using --instance directly, set --provider/--zone/--project or configure provider defaults." >&2
      exit 1
    fi
    IP="$(instance_ip_for "${PROVIDER}" "${INSTANCE}" "${ZONE}" "${PROJECT}")"
    if [[ "${INSTANCE}" == ctfvm-* ]]; then
      RUN_ID="$(run_id_from_instance_name "${INSTANCE}")"
    else
      RUN_ID=""
    fi
  else
    load_state_required
    local_selector_used="1"
  fi

  if [[ -f "${STATE_FILE}" ]]; then
    local state_instance state_zone state_project
    state_instance="$(json_get instance || true)"
    state_zone="$(json_get zone || true)"
    state_project="$(json_get project || true)"
    if [[ "${state_instance}" == "${INSTANCE}" && "${state_zone}" == "${ZONE}" && "${state_project}" == "${PROJECT}" ]]; then
      clear_state="1"
    fi
  fi

  if [[ "${no_wipe}" == "0" ]]; then
    echo "Wiping VM Codex session material before deletion..."
    gcloud_ssh "sudo -u ctf bash -lc '
      if [ -d /home/ctf/run/.codex ]; then
        find /home/ctf/run/.codex -type f -exec shred -u {} + 2>/dev/null || rm -rf /home/ctf/run/.codex
      fi
      if [ -d /home/ctf/.codex ]; then
        find /home/ctf/.codex -type f -exec shred -u {} + 2>/dev/null || rm -rf /home/ctf/.codex
      fi
      if [ -d /home/ctf/.docker ]; then
        find /home/ctf/.docker -type f -exec shred -u {} + 2>/dev/null || rm -rf /home/ctf/.docker
      fi
    '" || true
  fi

  echo "Deleting instance ${INSTANCE}..."
  if ! ctfvm_provider_call "${PROVIDER}" delete_instance "${INSTANCE}" "${ZONE}" "${PROJECT}"; then
    echo "Instance deletion returned non-zero (possibly already deleted). Clearing local state anyway."
  fi

  cleanup_local_state_for_instance "${INSTANCE}" "${ZONE}" "${PROJECT}"

  if [[ "${local_selector_used}" == "1" || "${clear_state}" == "1" ]]; then
    echo "Run destroyed and matching local state cleared."
  else
    echo "Run destroyed."
  fi
}

cmd_cleanup_state() {
  ensure_state_dir

  local dry_run="0"
  local prune_non_running="0"
  local removed=0
  local kept=0
  local checked=0
  local promoted_current="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run="1"; shift ;;
      --prune-non-running)
        prune_non_running="1"; shift ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1 ;;
    esac
  done

  cleanup_one_state_file() {
    local file="$1"
    local label="$2"
    local inst zn proj provider status reason remove_now

    [[ -f "${file}" ]] || return 0

    provider="$(provider_from_state_file "${file}")"
    inst="$(json_get_from_file instance "${file}" || true)"
    zn="$(json_get_from_file zone "${file}" || true)"
    proj="$(json_get_from_file project "${file}" || true)"
    checked=$((checked + 1))

    remove_now="0"
    reason=""
    if [[ -z "${inst}" || -z "${zn}" || -z "${proj}" ]]; then
      remove_now="1"
      reason="incomplete metadata"
    else
      if [[ "${provider}" == "gcp" ]] && ! command -v gcloud >/dev/null 2>&1; then
        status="CLI_MISSING"
      elif [[ "${provider}" == "digitalocean" ]] && ! command -v doctl >/dev/null 2>&1; then
        status="CLI_MISSING"
      else
        status="$(instance_status_for "${provider}" "${inst}" "${zn}" "${proj}")"
      fi
      if [[ "${status}" == "CLI_MISSING" ]]; then
        reason="provider CLI unavailable"
      elif [[ -z "${status}" ]]; then
        remove_now="1"
        reason="instance not found"
      elif [[ "${prune_non_running}" == "1" && "${status}" != "RUNNING" && "${status}" != "active" ]]; then
        remove_now="1"
        reason="instance status=${status}"
      fi
    fi

    if [[ "${remove_now}" == "1" ]]; then
      removed=$((removed + 1))
      if [[ "${dry_run}" == "1" ]]; then
        echo "[dry-run] remove ${label}: ${file} (${reason})"
      else
        rm -f "${file}"
        echo "Removed ${label}: ${file} (${reason})"
      fi
    else
      kept=$((kept + 1))
    fi
  }

  local f
  for f in "${RUNS_DIR}"/*.json; do
    [[ -e "${f}" ]] || continue
    cleanup_one_state_file "${f}" "run"
  done
  if [[ -f "${STATE_FILE}" ]]; then
    cleanup_one_state_file "${STATE_FILE}" "current"
  fi

  if [[ "${dry_run}" == "0" && ! -f "${STATE_FILE}" ]]; then
    local latest_run=""
    latest_run="$(ls -1t "${RUNS_DIR}"/*.json 2>/dev/null | head -n1 || true)"
    if [[ -n "${latest_run}" && -f "${latest_run}" ]]; then
      cp "${latest_run}" "${STATE_FILE}"
      promoted_current="1"
      echo "Set current state from: ${latest_run}"
    fi
  fi

  echo "Cleanup complete: checked=${checked}, removed=${removed}, kept=${kept}"
  if [[ "${dry_run}" == "1" ]]; then
    echo "Dry-run only: no files were changed."
  fi
  if [[ "${promoted_current}" == "1" ]]; then
    echo "Current state was missing and has been restored from the newest remaining run."
  fi
}

usage() {
  cat <<USAGE
Usage:
  ctfvm start --provider gcp|digitalocean --dir <challenge-folder> [--desc <text> | --desc-file <path>] [--ideas <text>] [--timeout-min 1440] [--machine-type e2-standard-4 | --size-slug s-4vcpu-8gb] [--zone <zone-or-region>] [--project <project>] [--ssh-key <fingerprint>] [--toolbox-image <artifact-registry-ref> | --toolbox-location <region> --toolbox-repository <repo> --toolbox-image-name <name> --toolbox-tag <tag> | --use-local-image [--local-image-archive <path>]] [--toolbox-variant lean|full] [--boot-image <image> | --boot-image-family <family> [--boot-image-project <project>]] [--no-auth-sync]
  ctfvm image build-local [--archive <path>] [--platform linux/amd64] [--variant lean|full]
  ctfvm image push-registry --provider gcp|digitalocean [--project <project>] [--location <region>] [--repository <repo>] [--image-name <name>] [--tag <tag>] [--registry-tier basic] [--platform linux/amd64] [--variant lean|full]
  ctfvm image push-ar [--project <project>] [--location <region>] [--repository <repo>] [--image-name <name>] [--tag <tag>] [--platform linux/amd64] [--variant lean|full]
  ctfvm image status [--archive <path>]
  ctfvm status [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]]
  ctfvm attach [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>] | --ip <public-ip> [--provider digitalocean]]
  ctfvm chat [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>] | --ip <public-ip> [--provider digitalocean]]
  ctfvm shell [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>] | --ip <public-ip> [--provider digitalocean]]
  ctfvm logs [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]]
  ctfvm monitor [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]]
  ctfvm ui [--host 127.0.0.1] [--port 8765]
  ctfvm bridge [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] <up|status|down|list> [args...]
  ctfvm mcp [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] [--restart-supervisor] <list|get|add|remove|login|logout> [args...]
  ctfvm inject [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] --msg <text>
  ctfvm send [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] --text <text> [--target <session>:<window-or-pane>] [--no-enter]
  ctfvm key [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] [--target <session>:<window-or-pane>] --key <tmux-key> [--key <tmux-key> ...]
  ctfvm ideas [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] (--ideas "idea1;idea2" | --ideas-file <local-file>) [--parallel <n>] [--model gpt-5.3-codex]
  ctfvm sync-skill [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] [--skill <skill-name>]
  ctfvm sync-down [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] [--out <local-dir>] [--remote-path </home/ctf/run/challenge>]
  ctfvm sync-up [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] --src <local-dir> [--remote-path </home/ctf/run/challenge>]
  ctfvm vscode [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] [--remote-path </home/ctf/run/challenge>]
  ctfvm fetch [--pick | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...> [--provider gcp|digitalocean --zone <zone-or-region> --project <project>]] [--out <local-dir>]
  ctfvm destroy [--pick | --all | --run-id <YYYYmmdd-HHMMSS> | --instance <ctfvm-...>] [--provider gcp|digitalocean --zone <zone-or-region> --project <project>] [--no-wipe-auth]
  ctfvm cleanup-state [--dry-run] [--prune-non-running]
USAGE
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  local cmd="$1"
  shift

  case "${cmd}" in
    image)
      cmd_image "$@" ;;
    start) cmd_start "$@" ;;
    status) cmd_status "$@" ;;
    attach) cmd_attach "$@" ;;
    chat) cmd_chat "$@" ;;
    shell) cmd_shell "$@" ;;
    logs) cmd_logs "$@" ;;
    monitor) cmd_monitor "$@" ;;
    ui) cmd_ui "$@" ;;
    bridge) cmd_bridge "$@" ;;
    mcp) cmd_mcp "$@" ;;
    inject) cmd_inject "$@" ;;
    send) cmd_send "$@" ;;
    key) cmd_key "$@" ;;
    ideas) cmd_ideas "$@" ;;
    sync-skill) cmd_sync_skill "$@" ;;
    sync-down) cmd_sync_down "$@" ;;
    sync-up) cmd_sync_up "$@" ;;
    vscode) cmd_vscode "$@" ;;
    fetch) cmd_fetch "$@" ;;
    destroy) cmd_destroy "$@" ;;
    cleanup-state) cmd_cleanup_state "$@" ;;
    *)
      echo "Unknown command: ${cmd}" >&2
      usage
      exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
