  echo "Instance: ${INSTANCE}"
  echo "Project:  ${PROJECT}"
  echo "Zone:     ${ZONE}"
  echo "Status:   ${status:-UNKNOWN}"
  echo "IP:       ${ip:-unknown}"
  echo "Run ID:   ${RUN_ID}"
  echo "State:    ${STATE_FILE}"
}

