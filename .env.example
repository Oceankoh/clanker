# clanker configuration — copy to `.env` and edit. `.env` is gitignored.
#
# Precedence (highest first):  CLI flag > .env > shell env > .ctfvm/secrets.json
#                              > .ctfvm/config.json > built-in default
#
# `python -m clanker config show` prints the resolved value + source for each knob.
# Secrets (API keys / tokens) are better set in the shell env or via
# `clanker auth claude`; they are shown here only for completeness.

# ============================================================================
# Agent backend
# ============================================================================
CTFVM_AGENT=codex                     # default agent backend: codex | claude-code
CTFVM_MODEL=                          # default model (blank = backend default; codex -> gpt-5.5)
CTFVM_REASONING_EFFORT=xhigh          # codex model_reasoning_effort (codex only)

# Codex auth: by default the local ~/.codex session is synced to the VM.
CTFVM_CODEX_HOME=~/.codex             # local Codex session dir to sync
CTFVM_NO_AUTH_SYNC=                   # set to 1 to skip session sync and use OPENAI_API_KEY
# OPENAI_API_KEY=sk-...               # Codex API-key mode (alternative to session sync)

# Claude auth: prefer `clanker auth claude` (stores a token in .ctfvm/secrets.json).
# CLAUDE_CODE_OAUTH_TOKEN=...         # subscription OAuth token (from `claude setup-token`)
# ANTHROPIC_API_KEY=sk-ant-...        # console API key (alternative)

CTFVM_DEFAULT_IDA_MCP_URL=            # remote IDA MCP server URL (optional)

# ============================================================================
# Cloud provider
# ============================================================================
CTFVM_PROVIDER=digitalocean           # gcp | digitalocean

# --- GCP ---
CTFVM_GCP_PROJECT=                    # falls back to `gcloud config get-value project`
CTFVM_GCP_ZONE=us-central1-a
CTFVM_GCP_MACHINE_TYPE=e2-standard-4
CTFVM_GCP_NETWORK=                    # optional VPC attachment
CTFVM_GCP_SUBNET=
CTFVM_GCP_NETWORK_TAGS=

# --- DigitalOcean ---
CTFVM_DO_REGION=sgp1
CTFVM_DO_SIZE_SLUG=s-2vcpu-4gb
CTFVM_DO_SSH_KEYS=                    # comma-separated fingerprints (optional break-glass)
CTFVM_DO_VPC_ID=
CTFVM_DO_TAGS=

# ============================================================================
# Toolbox image
# ============================================================================
CTFVM_TOOLBOX_VARIANT=lean            # lean | full
CTFVM_LOCAL_IMAGE_ARCHIVE=            # path for `--use-local-image` fallback

# --- Golden VM image (pre-baked: tools + agent CLIs, no Docker, no credentials) ---
# Blank => boot the stock distro image + slow startup install. Build with
# `clanker image bake --provider digitalocean`; check age with `clanker image status`.
# Usually left blank — the effective id is read from .ctfvm/golden-image.json.
CTFVM_GOLDEN_IMAGE_DO=                 # DigitalOcean golden image id/slug
CTFVM_GOLDEN_IMAGE_GCP=               # GCP golden image name
CTFVM_DO_SSH_KEY=                     # SSH key (name/fingerprint) the bake builder uses

# ============================================================================
# Control plane / run
# ============================================================================
CTFVM_CONTROL_PORT=443                # control-plane TCP port
CTFVM_TIMEOUT_MIN=1440                # VM self-destruct timeout (minutes)
CTFVM_CONTROL_TIMEOUT_SEC=1800        # control-plane exec timeout
CTFVM_CONTROL_UPLOAD_TIMEOUT_SEC=240
CTFVM_CONTROL_DOWNLOAD_TIMEOUT_SEC=600

# ============================================================================
# Local-network VPN (WireGuard)
# ============================================================================
CTFVM_VPN=1                           # auto-start the VPN (1 | 0)
CTFVM_VPN_CIDRS=                      # comma-separated CIDRs to route (default RFC1918)
CTFVM_VPN_PORT=51820
CTFVM_VPN_EGRESS_IF=                  # override local egress interface if auto-detect is wrong
CTFVM_VPN_DNS=auto                    # auto (default: forward DNS via this laptop) | off | <ip,ip> (explicit upstreams)
